{
  "manifest_version": 3,
  "name": "Kylas Overlay \u2014 Sales Intelligence",
  "version": "0.10.0",
  "description": "Surfaces curated Airtable company data and one-click meeting booking directly inside Kylas.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "host_permissions": [
    "https://app.kylas.io/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://api.airtable.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.kylas.io/*"
      ],
      "js": [
        "config/field-map.js",
        "config/queue.js",
        "content/shared.js",
        "content/company-overlay.js",
        "content/contact-overlay.js",
        "content/home-overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles/overlay.css"
      ],
      "matches": [
        "https://app.kylas.io/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
